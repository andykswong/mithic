{
  "name": "@mithic/example-rust-component",
  "version": "0.3.0",
  "private": "true",
  "description": "mithic example WASI component in Rust",
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./component": "./dist/index.js",
    "./component/jspi": "./dist/jspi.js",
    "./component/asyncify": "./dist/asyncify.js",
    "./component/core/*": "./dist/core/*",
    "./component/core-asyncify/*": "./dist/core-asyncify/*",
    "./component.js": "./dist/component.js",
    "./component.async.js": "./dist/component.async.js"
  },
  "config": {
    "crate": "mithic_example_cli",
    "target": "wasm32-wasip2"
  },
  "scripts": {
    "prepare": "rustup target add $npm_package_config_target",
    "prebuild": "eslint && mkdir -p dist/core dist/core-asyncify",
    "build": "cargo build -p $npm_package_config_crate -r --target $npm_package_config_target",
    "postbuild": "cp ../../../target/${npm_package_config_target}/release/${npm_package_config_crate}.wasm ./dist/component.wasm && npm run transpile",
    "transpile": "wasm-transpile ./dist/component.wasm -o ./dist --variants sync,jspi,asyncify --asyncify-pages 4",
    "clean": "rimraf dist",
    "start": "TEST=itworks node .",
    "start:jspi": "TEST=itworks node . --jspi",
    "start:asyncify": "TEST=itworks node . --asyncify",
    "test": "echo 'User' | npm start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/mithic.git"
  },
  "author": "Andy K.S. Wong <andykswong@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andykswong/mithic/issues"
  },
  "homepage": "https://github.com/andykswong/mithic",
  "dependencies": {
    "@mithic/io": "^0.4",
    "@mithic/wasip2": "^0.1",
    "@mithic/wasm-transpile": "0.1"
  },
  "devDependencies": {
  }
}
