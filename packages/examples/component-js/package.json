{
  "name": "@mithic/example-js-component",
  "version": "0.3.0",
  "private": "true",
  "description": "mithic example WASI component in JavaScript (ComponentizeJS)",
  "type": "module",
  "sideEffects": false,
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./component": "./dist/index.js"
  },
  "scripts": {
    "prebuild": "eslint && mkdir -p dist",
    "build": "jco componentize src/index.js -w wit -n simple -d http -d fetch-event -o dist/component.wasm",
    "postbuild": "wasm-transpile ./dist/component.wasm -o ./dist",
    "clean": "rimraf dist",
    "start": "node .",
    "test": "npm start",
    "wit-fetch": "wkg wit fetch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/mithic.git"
  },
  "author": "Andy K.S. Wong <andykswong@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andykswong/mithic/issues"
  },
  "homepage": "https://github.com/andykswong/mithic",
  "dependencies": {
    "@mithic/io": "^2.0.0",
    "@mithic/wasip2": "^0.1"
  },
  "devDependencies": {
    "@bytecodealliance/componentize-js": "^0.21",
    "@mithic/wasm-transpile": "0.1"
  }
}
