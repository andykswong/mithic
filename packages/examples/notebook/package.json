  "dependencies": {
    "@mithic/coreutils": "2.0.0",
    "@mithic/curl": "2.0.0",
    "@mithic/guest-runtime": "2.0.0",
    "@mithic/io": "2.0.0",
    "@mithic/jq": "2.0.0",
    "@mithic/kernel": "2.0.0",
    "@mithic/protocol": "2.0.0",
    "@mithic/runtime": "2.0.0",
    "@mithic/shell": "2.0.0",
    "@xterm/xterm": "^6.0.0"
  }
