{
  "name": "@mithic/io",
  "version": "2.0.0",
  "description": "mithic I/O engine - file system, network providers, sync-bridge",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./io": "./dist/io/index.js",
    "./io/providers/node-stdio": "./dist/io/providers/node-stdio.js",
    "./io/providers/sync-bridge": "./dist/io/providers/sync-bridge.js",
    "./net": "./dist/net/index.js",
    "./net/providers/node-http-server": "./dist/net/providers/node-http-server.js",
    "./net/providers/node-socket-provider": "./dist/net/providers/node-socket-provider.js",
    "./vfs": "./dist/vfs/index.js",
    "./vfs/providers/node-fs": "./dist/vfs/providers/node-fs.js",
    "./vfs/providers/opfs": "./dist/vfs/providers/opfs.js"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "clean": "rimraf dist *.tsbuildinfo *.lcov",
    "prebuild": "npm run lint",
    "build": "vite build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"**/*.test.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov --test \"**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/mithic.git"
  },
  "keywords": [
    "mithic",
    "typescript",
    "wasm",
    "wasi"
  ],
  "author": "Andy K.S. Wong <andykswong@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andykswong/mithic/issues"
  },
  "homepage": "https://github.com/andykswong/mithic",
  "dependencies": {
  },
  "devDependencies": {
  }
}
