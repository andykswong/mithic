{
  "name": "@mithic/wasm-transpile",
  "version": "0.1.0",
  "description": "WASM component transpiler with asyncify JSPI polyfill",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./asyncify": "./dist/asyncify/index.js",
    "./transpile": "./dist/transpile.js"
  },
  "bin": {
    "wasm-transpile": "./bin/wasm-transpile.js"
  },
  "files": [
    "/bin",
    "/dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "clean": "rimraf dist *.tsbuildinfo",
    "prebuild": "npm run lint",
    "build": "vite build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "demo:transpile": "node src/cli.ts ../examples/rust-cli/dist/component.wasm --async-mode asyncify --no-minify -o dist/example",
    "demo": "node examples/demo.ts",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/mithic.git"
  },
  "keywords": [
    "mithic",
    "wasm",
    "asyncify",
    "jspi",
    "transpile",
    "jco"
  ],
  "author": "Andy K.S. Wong <andykswong@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andykswong/mithic/issues"
  },
  "homepage": "https://github.com/andykswong/mithic",
  "dependencies": {
    "binaryen": "^130",
    "@bytecodealliance/jco": "^1.20"
  },
  "devDependencies": {
    "@mithic/wasip2": "^0.1"
  }
}
