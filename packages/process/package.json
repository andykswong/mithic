{
  "name": "@mithic/process",
  "version": "0.1.0",
  "description": "mithic process management - shell, process spawn",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./manager": "./dist/manager.js",
    "./types": "./dist/types.js",
    "./imports": "./dist/imports.js",
    "./instantiation": "./dist/instantiation.js",
    "./io": "./dist/io/pipes.js",
    "./io/slots": "./dist/io/slots.js",
    "./io/signal-stream": "./dist/io/signal-stream.js",
    "./manager/simple": "./dist/manager/simple.js",
    "./manager/worker": "./dist/manager/worker.js",
    "./manager/proxy": "./dist/manager/proxy.js",
    "./component/eval-jco": "./dist/component/eval-jco.js",
    "./component/registry": "./dist/component/registry.js",
    "./component/compiler": "./dist/component/compiler.js",
    "./worker/compiler": "./dist/worker/compiler.js",
    "./worker/compiler.node": "./dist/worker/compiler.node.js",
    "./worker/compiler.browser": "./dist/worker/compiler.browser.js",
    "./worker/process": "./dist/worker/process.js",
    "./worker/process.node": "./dist/worker/process.node.js",
    "./worker/process.browser": "./dist/worker/process.browser.js",
    "./wit/*": "./wit/*"
  },
  "files": [
    "/dist",
    "/wit"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "clean": "rimraf dist *.tsbuildinfo *.lcov",
    "prebuild": "npm run lint",
    "build": "vite build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"**/*.test.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov --test \"**/*.test.ts\"",
    "wit-fetch": "wkg wit fetch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/mithic.git"
  },
  "keywords": [
    "mithic",
    "typescript",
    "wasm",
    "process",
    "shell"
  ],
  "author": "Andy K.S. Wong <andykswong@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andykswong/mithic/issues"
  },
  "homepage": "https://github.com/andykswong/mithic",
  "dependencies": {
    "@mithic/io": "^0.4",
    "@mithic/wasip2": "^0.1"
  },
  "peerDependencies": {
    "@bytecodealliance/jco": "^1.20"
  },
  "peerDependenciesMeta": {
    "@bytecodealliance/jco": {
      "optional": true
    }
  },
  "devDependencies": {
  }
}
