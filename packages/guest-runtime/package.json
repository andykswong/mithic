{
  "name": "@mithic/guest-runtime",
  "version": "2.0.0",
  "description": "Isola guest runtime — isola.* API, fd table, pipe-protocol streams, transport adapter",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./streams": { "types": "./dist/streams.d.ts", "import": "./dist/streams.js" },
    "./remote-dom": { "types": "./dist/remote-dom.d.ts", "import": "./dist/remote-dom.js" }
  },
  "files": ["/dist"],
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "prebuild": "npm run lint",
    "build": "vite build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mithic/protocol": "2.0.0"
  },
  "devDependencies": {
    "@mithic/runtime": "2.0.0"
  },
  "license": "MIT"
}
