{
  "name": "@mithic/react",
  "version": "0.3.0",
  "description": "React virtual DOM adapter for mithic",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run doc",
    "clean": "rimraf docs dist *.lcov",
    "prebuild": "npm run lint",
    "build": "npm run tsc && npm run babel",
    "lint": "eslint",
    "babel": "babel src -d dist -x '.ts' --root-mode upward",
    "tsc": "tsc --project tsconfig.build.json",
    "test": "COLORS=false node --experimental-strip-types --experimental-test-snapshots --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"src/test/**/*.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov --test \"**/*.test.ts\"",
    "test:update": "COLORS=false node --experimental-strip-types --experimental-test-snapshots --test-update-snapshots --test \"**/*.test.ts\"",
    "doc": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/mithic.git"
  },
  "keywords": [
    "mithic",
    "react",
    "typescript"
  ],
  "author": "Andy K.S. Wong <andykswong@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andykswong/mithic/issues"
  },
  "homepage": "https://github.com/andykswong/mithic",
  "dependencies": {
    "@mithic/commons": "^0.3",
    "@mithic/dom": "^0.3",
    "@types/react": "^19.0",
    "@types/react-dom": "^19.0"
  },
  "peerDependencies": {
    "react": "^19.0",
    "react-dom": "^19.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0"
  }
}
