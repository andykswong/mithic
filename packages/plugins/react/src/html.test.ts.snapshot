exports[`ReactHtmlStringRootProvider > update > should render patched virtual DOM to HTML string 1`] = `
[
  "body",
  "<div id=\\"test\\" class=\\"container newClass\\" style=\\"display:inline-block;height:50px\\" data-id=\\"1\\">New <img href=\\"./test.img\\" style=\\"color:red\\" data-id=\\"2\\"/>world~</div>"
]
`;
