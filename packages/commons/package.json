{
  "name": "@mithic/commons",
  "version": "0.3.0",
  "description": "Common utilities for mithic",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run doc",
    "clean": "rimraf docs dist .swc *.tsbuildinfo *.lcov",
    "prebuild": "npm run lint",
    "build": "npm run tsc && npm run swc",
    "lint": "eslint",
    "swc": "swc src -d dist --strip-leading-paths --ignore **/*.test.ts --config-file ../../.swcrc",
    "tsc": "tsc --project tsconfig.build.json",
    "test": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"**/*.test.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov --test \"**/*.test.ts\"",
    "doc": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/mithic.git"
  },
  "keywords": [
    "mithic",
    "typescript"
  ],
  "author": "Andy K.S. Wong <andykswong@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andykswong/mithic/issues"
  },
  "homepage": "https://github.com/andykswong/mithic",
  "dependencies": {
  },
  "devDependencies": {
  }
}
