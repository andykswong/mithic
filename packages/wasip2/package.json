{
  "name": "@mithic/wasip2",
  "version": "0.1.0",
  "description": "WASI Preview 2 shim for mithic",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./instantiation": "./dist/instantiation.js",
    "./imports": "./dist/imports.js",
    "./cli/environment": "./dist/cli/environment.js",
    "./cli/exit": "./dist/cli/exit.js",
    "./cli/stdin": "./dist/cli/stdin.js",
    "./cli/stdout": "./dist/cli/stdout.js",
    "./cli/stderr": "./dist/cli/stderr.js",
    "./cli/terminal-input": "./dist/cli/terminal-input.js",
    "./cli/terminal-output": "./dist/cli/terminal-output.js",
    "./cli/terminal-stdin": "./dist/cli/terminal-stdin.js",
    "./cli/terminal-stdout": "./dist/cli/terminal-stdout.js",
    "./cli/terminal-stderr": "./dist/cli/terminal-stderr.js",
    "./clocks/monotonic-clock": "./dist/clocks/monotonic-clock.js",
    "./clocks/wall-clock": "./dist/clocks/wall-clock.js",
    "./filesystem/preopens": "./dist/filesystem/preopens.js",
    "./filesystem/sync-fs-handler": "./dist/filesystem/sync-fs-handler.js",
    "./filesystem/types": "./dist/filesystem/types.js",
    "./http/types": "./dist/http/types.js",
    "./http/outgoing-handler": "./dist/http/outgoing-handler.js",
    "./http/incoming-handler": "./dist/http/incoming-handler.js",
    "./io/error": "./dist/io/error.js",
    "./io/poll": "./dist/io/poll.js",
    "./io/streams": "./dist/io/streams.js",
    "./random/insecure": "./dist/random/insecure.js",
    "./random/insecure-seed": "./dist/random/insecure-seed.js",
    "./random/random": "./dist/random/random.js",
    "./sockets/instance-network": "./dist/sockets/instance-network.js",
    "./sockets/ip-name-lookup": "./dist/sockets/ip-name-lookup.js",
    "./sockets/network": "./dist/sockets/network.js",
    "./sockets/tcp": "./dist/sockets/tcp.js",
    "./sockets/tcp-create-socket": "./dist/sockets/tcp-create-socket.js",
    "./sockets/udp": "./dist/sockets/udp.js",
    "./sockets/udp-create-socket": "./dist/sockets/udp-create-socket.js"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "clean": "rimraf dist *.tsbuildinfo *.lcov",
    "prebuild": "npm run lint",
    "build": "vite build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"**/*.test.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov --test \"**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/mithic.git"
  },
  "keywords": [
    "mithic",
    "typescript",
    "wasm",
    "wasi",
    "wasip2",
    "preview2"
  ],
  "author": "Andy K.S. Wong <andykswong@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andykswong/mithic/issues"
  },
  "homepage": "https://github.com/andykswong/mithic",
  "dependencies": {
    "@mithic/io": "^0.4"
  },
  "devDependencies": {
  }
}
