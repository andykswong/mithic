package mithic:process@0.1.0;

interface types {
  use wasi:io/streams@0.2.6.{input-stream, output-stream};
  use wasi:filesystem/types@0.2.6.{descriptor};

  /// Handle to a running process (lifecycle only).
  /// Streams are pre-wired at spawn time via spawn-options,
  /// not extracted from the process after creation.
  resource process {
    /// Get the process ID.
    pid: func() -> u32;

    /// Wait for the process to exit. Returns the exit status code.
    wait: func() -> status-code;

    /// Non-blocking check: returns exit code if process has exited, none if still running.
    try-wait: func() -> option<status-code>;

    /// Send a signal to the process.
    kill: func(signal: signal) -> result<_, error-code>;
  }

  /// Options for spawning a process.
  record spawn-options {
    /// Capability-based working directory for the child process.
    cwd: option<descriptor>,
    /// Environment variables. If omitted, inherits parent.
    env: option<list<tuple<string, string>>>,
    /// Pre-wired stdin stream for the child. If omitted, inherits host default.
    stdin: option<input-stream>,
    /// Pre-wired stdout stream for the child. If omitted, inherits host default.
    stdout: option<output-stream>,
    /// Pre-wired stderr stream for the child. If omitted, inherits host default.
    stderr: option<output-stream>,
  }

  /// Process exit status code.
  type status-code = u8;

  /// POSIX signals.
  enum signal {
    sigterm,
    sigkill,
    sigint,
    sigtstp,
    sigcont,
    signull,
  }

  variant error-code {
    not-found,
    permission-denied,
    invalid-argument,
    resource-exhausted,
    broken-pipe,
    other(string),
  }
}

interface manager {
  use types.{process, spawn-options, error-code};
  use wasi:io/streams@0.2.6.{input-stream, output-stream};

  /// Spawn a child process with optional pre-wired I/O capabilities.
  spawn: func(
    file: string,
    args: list<string>,
    options: option<spawn-options>
  ) -> result<process, error-code>;

  /// Create an anonymous pipe (linked input/output stream pair).
  /// Data written to the output-stream is readable from the input-stream.
  create-pipe: func() -> tuple<input-stream, output-stream>;

  /// Duplicate an output-stream: returns a new handle writing to the same destination.
  /// Disposing the duplicate does NOT close the original stream's destination.
  dup-output-stream: func(src: borrow<output-stream>) -> output-stream;
}

world imports {
  import types;
  import manager;
}
