{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "strict": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "incremental": true
  },
  "exclude": [
    "node_modules",
    "**/dist/*"
  ]
}
