{
  "name": "mithic",
  "version": "0.3.0",
  "description": "Modular library for universal full-stack applications",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "preinstall": "cargo install wasm-tools wkg --root .",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run doc",
    "build": "npm run build --ws --if-present",
    "clean": "npm run clean --ws --if-present && rimraf docs/api",
    "dev": "npm run dev --workspace=packages/examples/browser",
    "doc": "typedoc",
    "lint": "eslint",
    "typecheck": "npm run typecheck --ws --if-present",
    "test": "npm test --ws --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/mithic.git"
  },
  "keywords": [
    "collaboration",
    "cqrs",
    "crdt",
    "decentralized",
    "distributed",
    "eventsourcing",
    "eventstore",
    "p2p",
    "offline-first",
    "state-channel",
    "triplestore",
    "typescript",
    "wasm",
    "webassembly",
    "web3"
  ],
  "author": "Andy K.S. Wong <andykswong@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andykswong/mithic/issues"
  },
  "homepage": "https://github.com/andykswong/mithic",
  "dependencies": {
    "@mithic/commons": "^0.3",
    "@mithic/core": "^0.3",
    "@mithic/keyvalue": "^0.3",
    "@mithic/messaging": "^0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0",
    "@stylistic/eslint-plugin": "^5.0",
    "@types/node": "^25.0",
    "@vitejs/plugin-react": "^6.0",
    "cross-env": "^10.0",
    "eslint": "^10.0",
    "globals": "^17.0",
    "global-jsdom": "^29.0",
    "jsdom": "^29.0",
    "rimraf": "^6.0",
    "typedoc": "^0.28",
    "typescript": "^6.0",
    "typescript-eslint": "^8.50",
    "vite": "^8.0",
    "vite-plugin-dts": "^5.0"
  },
  "workspaces": [
    "./packages/commons",
    "./packages/core",
    "./packages/keyvalue",
    "./packages/messaging",
    "./packages/plugins/denokv",
    "./packages/plugins/level",
    "./packages/plugins/redis",
    "./packages/examples/simple",
    "./packages/examples/rust-cli",
    "./packages/examples/browser"
  ]
}
