{
  "name": "mithic",
  "version": "0.3.0",
  "description": "Modular library for universal full-stack applications",
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "./index.js",
    "./index.d.ts"
  ],
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "preinstall": "cargo install wasm-tools wit-deps-cli --root .",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run doc",
    "build": "npm run build -ws",
    "clean": "npm run clean -ws && rimraf docs",
    "doc": "typedoc",
    "test": "npm test -ws"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/mithic.git"
  },
  "keywords": [
    "collaboration",
    "cqrs",
    "crdt",
    "decentralized",
    "distributed",
    "eventsourcing",
    "eventstore",
    "p2p",
    "offline-first",
    "state-channel",
    "triplestore",
    "typescript",
    "wasm",
    "webassembly",
    "web3"
  ],
  "author": "Andy K.S. Wong <andykswong@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andykswong/mithic/issues"
  },
  "homepage": "https://github.com/andykswong/mithic",
  "dependencies": {
    "@mithic/commons": "^0.3",
    "@mithic/core": "^0.3",
    "@mithic/dom": "^0.3",
    "@mithic/keyvalue": "^0.3",
    "@mithic/messaging": "^0.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.25",
    "@babel/core": "^7.25",
    "@babel/plugin-proposal-explicit-resource-management": "^7.25",
    "@babel/preset-env": "^7.25",
    "@babel/preset-typescript": "^7.25",
    "@eslint/js": "^9.15",
    "@testing-library/dom": "^10.4",
    "@testing-library/user-event": "^14.5",
    "@types/node": "^22.10",
    "core-js": "^3.39",
    "cross-env": "^7.0",
    "eslint": "^9.15",
    "globals": "^15.10",
    "global-jsdom": "^25.0",
    "jsdom": "^25.0",
    "rimraf": "^6.0",
    "typedoc": "^0.27",
    "typescript": "^5.7",
    "typescript-eslint": "^8.15",
    "webpack": "^5.97",
    "webpack-cli": "^5.1",
    "webpack-dev-server": "^5.1"
  },
  "workspaces": [
    "./wit/dom",
    "./wit/keyvalue",
    "./wit/messaging",
    "./packages/commons",
    "./packages/core",
    "./packages/dom",
    "./packages/keyvalue",
    "./packages/messaging",
    "./packages/plugins/denokv",
    "./packages/plugins/level",
    "./packages/plugins/redis",
    "./packages/plugins/react",
    "./packages/examples/simple",
    "./packages/examples/rust-cli",
    "./packages/examples/browser"
  ]
}
