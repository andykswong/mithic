{
  "name": "mithic",
  "version": "0.3.0",
  "description": "Modular library for universal full-stack applications",
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "./index.js"
  ],
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "preinstall": "cargo install wasm-tools wit-deps-cli --root .",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run doc",
    "build": "npm run build -ws",
    "clean": "npm run clean -ws && rimraf docs",
    "doc": "typedoc",
    "test": "npm test -ws"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/mithic.git"
  },
  "keywords": [
    "collaboration",
    "cqrs",
    "crdt",
    "decentralized",
    "distributed",
    "eventsourcing",
    "eventstore",
    "p2p",
    "offline-first",
    "state-channel",
    "triplestore",
    "typescript",
    "wasm",
    "webassembly",
    "web3"
  ],
  "author": "Andy K.S. Wong <andykswong@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andykswong/mithic/issues"
  },
  "homepage": "https://github.com/andykswong/mithic",
  "dependencies": {
    "@mithic/commons": "^0.3",
    "@mithic/core": "^0.3",
    "@mithic/keyvalue": "^0.3",
    "@mithic/messaging": "^0.3"
  },
  "devDependencies": {
    "@swc/cli": "^0.6",
    "@swc/core": "^1.11",
    "@swc/plugin-transform-imports": "^7.0",
    "@eslint/js": "^9.20",
    "@stylistic/eslint-plugin": "^4.0",
    "@types/node": "^22.10",
    "core-js": "^3.40",
    "cross-env": "^7.0",
    "eslint": "^9.20",
    "eslint-config-next": "^15.2",
    "globals": "^16.0",
    "global-jsdom": "^26.0",
    "jsdom": "^26.0",
    "next": "^15.2",
    "rimraf": "^6.0",
    "typedoc": "^0.27",
    "typescript": "^5.7",
    "typescript-eslint": "^8.25"
  },
  "workspaces": [
    "./wit/keyvalue",
    "./wit/messaging",
    "./packages/commons",
    "./packages/core",
    "./packages/keyvalue",
    "./packages/messaging",
    "./packages/plugins/denokv",
    "./packages/plugins/level",
    "./packages/plugins/redis",
    "./packages/examples/simple",
    "./packages/examples/rust-cli",
    "./packages/examples/browser"
  ]
}
