{
  "name": "@mithic/interface-dom",
  "version": "0.3.0",
  "description": "virtual DOM WIT spec",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/dom.wasm",
  "exports": {
    ".": "./dist/dom.wasm"
  },
  "files": [
    "/dist",
    "/wit"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean && npm run build",
    "clean": "rimraf dist",
    "prebuild": "mkdir -p dist",
    "build": "../../bin/wasm-tools component wit -w -o dist/dom.wasm wit",
    "test": "echo \"ok\"",
    "wit-deps": "../../bin/wit-deps"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/mithic.git"
  },
  "keywords": [
    "mithic",
    "typescript",
    "virtual-dom",
    "wit"
